# Resend API Key - Get from your Resend dashboard
RESEND_API_KEY="your_resend_api_key_here"

# Email address to send contact form submissions TO
# This is your personal email where you want to receive the messages
EMAIL_TO="your-personal-email@example.com"

# Email address to send contact form submissions FROM
# This MUST be a domain you have verified with Resend (e.g., contact@yourdomain.com or noreply@yourdomain.com)
# Using 'onboarding@resend.dev' might work for testing if your Resend account is new, but is not for production.
EMAIL_FROM="onboarding@resend.dev"

# Optional: Your website's public URL (used for some email templates or links if needed)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
